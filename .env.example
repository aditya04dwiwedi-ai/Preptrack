# Copy this file to ".env" (same folder as app.py) and fill in your key.
# NEVER share or upload your real .env file.

# Which provider to use: gemini (default, has a free tier) or openai
AI_PROVIDER=gemini

# Free key: https://aistudio.google.com/  ->  "Get API key"
GEMINI_API_KEY=
# 'gemini-flash-latest' is a rolling alias that survives model retirements. PrepBot also auto-falls back to other
# models if the one named here is missing, and prints which one it used in the terminal.
GEMINI_MODEL=gemini-flash-latest

# Only needed if AI_PROVIDER=openai  (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
